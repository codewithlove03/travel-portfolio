# Frontend environment variables
# Rename this to .env and fill in your values

# Your deployed backend URL (or localhost for development)
VITE_API_URL=http://localhost:5000/api

# Your name — shown on hero and about sections
VITE_OWNER_NAME=Your Name

# Tagline shown on the hero section
VITE_TAGLINE=Wanderer. Storyteller. Explorer.
