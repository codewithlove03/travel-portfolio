# ─────────────────────────────────────────
#  TRAVEL PORTFOLIO — Backend Environment
# ─────────────────────────────────────────

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/travel-portfolio?retryWrites=true&w=majority

# JWT Secret — use a long random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_please

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Node environment
NODE_ENV=development

# Cloudinary — get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin credentials (used when seeding the first admin account)
ADMIN_EMAIL=admin@youremail.com
ADMIN_PASSWORD=StrongPassword123!
